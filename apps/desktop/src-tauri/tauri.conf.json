{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "OAS Studio",
  "version": "2.2.1",
  "identifier": "com.oas.studio",
  "build": {
    "frontendDist": "../../web",
    "devUrl": "http://127.0.0.1:3456"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OAS Studio & Cloud Control Plane",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
